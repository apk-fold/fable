{
  "name": "fable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fable — suivi des heures, majorations et indemnités (intérim, CDD, CDI), empaqueté en APK avec Capacitor",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "sync": "vite build && cap sync android && node scripts/patch-android.mjs",
    "open": "cap open android",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^6.4.4"
  }
}
